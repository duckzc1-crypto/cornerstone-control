# Set these in Vercel (Project Settings -> Environment Variables), or in .env.local for local runs.
# They are read on the server only (app/api/[...path]/route.ts); the browser never sees them.

# Where the backend answers, e.g. https://192-154-110-26.sslip.io  (no trailing slash)
BACKEND_URL=http://127.0.0.1:8000

# The same token as /root/api_token.txt on the server (API_TOKEN).
BACKEND_TOKEN=
